{
  "expo": {
    "name": "Presence",
    "slug": "presence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "presence",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.presence.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Presence needs access to your photos to verify your connection screenshot.",
        "NSCameraUsageDescription": "Presence needs camera access to capture your connection proof."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "package": "com.presence.app",
      "permissions": [
        "PACKAGE_USAGE_STATS",
        "SYSTEM_ALERT_WINDOW",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "FOREGROUND_SERVICE",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2",
          "dark": {
            "backgroundColor": "#261B10"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Presence needs your photo library to verify your connection screenshot."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
