{
  "expo": {
    "name": "Presence",
    "slug": "presence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "presence",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.franciccio.presence",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Presence needs access to your photos to verify your connection screenshot.",
        "NSCameraUsageDescription": "Presence needs camera access to capture your connection proof.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.family-controls": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FAF7F2"
      },
      "package": "com.franciccio.presence",
      "permissions": [
        "android.permission.PACKAGE_USAGE_STATS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2",
          "dark": {
            "backgroundColor": "#261B10"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Presence needs your photo library to verify your connection screenshot."
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.477480292838-crt7tbqla5dtt3uosfefjvbc7lbebnk8"
        }
      ],
      "./plugins/withScreenTime.js",
      "./plugins/withAndroidBlocker.js",
      "./plugins/withSwiftFiles.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D6B588",
          "defaultChannel": "presence-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0790d724-e520-4239-987b-24ecc853d1f9"
      }
    }
  }
}
